{
  "n_comps_kept": 11,
  "comp_types": {
    "SEMANTIC_ABSTRACTION": 7,
    "EXTRACTION_REPAIR": 4
  },
  "kept_texts": [
    {
      "id": "v52_01-c1",
      "type": "SEMANTIC_ABSTRACTION",
      "text": "Parental responsiveness means responding to a child's needs supportively and acceptingly.",
      "passages": [
        "chunk-d18ea2208de791c87309c2f0287060f3"
      ]
    },
    {
      "id": "v52_01-c2",
      "type": "SEMANTIC_ABSTRACTION",
      "text": "Parental demandingness involves behavioral rules, compliance expectations, and repercussions for breaking rules.",
      "passages": [
        "chunk-d18ea2208de791c87309c2f0287060f3"
      ]
    },
    {
      "id": "v52_02-c1",
      "type": "EXTRACTION_REPAIR",
      "text": "TVNorge's first broadcast was a live variety show.",
      "passages": [
        "chunk-4307a7a644e425bceaeaf35cc9120869"
      ]
    },
    {
      "id": "v52_02-c2",
      "type": "EXTRACTION_REPAIR",
      "text": "TVNorge's first broadcast featured Lill-Babs and Tomboy as musical guests.",
      "passages": [
        "chunk-4307a7a644e425bceaeaf35cc9120869"
      ]
    },
    {
      "id": "v52_04-c1",
      "type": "EXTRACTION_REPAIR",
      "text": "The 2003 meeting had 322 persons in attendance at sessions.",
      "passages": [
        "chunk-34f60cd0b3a1c203f5442a6821679b98"
      ]
    },
    {
      "id": "v52_05-c2",
      "type": "EXTRACTION_REPAIR",
      "text": "The Second Battle of Rivas involved militia commanded by General Mora.",
      "passages": [
        "chunk-79421361c5e4c834e88955dcdadd06be"
      ]
    },
    {
      "id": "v52_07-c2",
      "type": "SEMANTIC_ABSTRACTION",
      "text": "Utva River is an indirect tributary of the Kama River.",
      "passages": [
        "chunk-c0eb2d588ced2105b38e9094111c65dd"
      ]
    },
    {
      "id": "v52_07-c3",
      "type": "SEMANTIC_ABSTRACTION",
      "text": "Chugrum River is an indirect tributary of the Kama River.",
      "passages": [
        "chunk-c0eb2d588ced2105b38e9094111c65dd"
      ]
    },
    {
      "id": "v52_09-c1",
      "type": "SEMANTIC_ABSTRACTION",
      "text": "CIDOB indirectly pressured the national government to sign ILO Convention 169.",
      "passages": [
        "chunk-615fadf8924b2c36d5585e0873c5adc8"
      ]
    },
    {
      "id": "v52_09-c2",
      "type": "SEMANTIC_ABSTRACTION",
      "text": "Indigenous revolts continued after the National Revolutionary Movement government began.",
      "passages": [
        "chunk-615fadf8924b2c36d5585e0873c5adc8"
      ]
    },
    {
      "id": "v52_09-c3",
      "type": "SEMANTIC_ABSTRACTION",
      "text": "The 1990 March for Territory and Dignity preceded the 1994 Law of Popular Participation.",
      "passages": [
        "chunk-615fadf8924b2c36d5585e0873c5adc8"
      ]
    }
  ],
