   "paper_id": "1910.09982",
   "group_id": "1910.09982::s00",
   "concise_text": "Team newspeak achieved the best results on the test set for the FLC task using 20-way word-level classification based on BERT, whose best model used the uncased base model of BERT with 12 Transformer layers and 110 million parameters.",
   "triple": {
    "subject": "20-way word-level classification based on BERT",
    "predicate": "outperforms",
    "object": "the FLC task test set"
