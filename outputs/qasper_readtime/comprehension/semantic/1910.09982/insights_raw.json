   "paper_id": "1910.09982",
   "group_id": "1910.09982::s00",
   "concise_text": "Because SLC is a binary classification task with imbalanced data, its official evaluation measure is the standard F$_1$ measure.",
   "triple": {
    "subject": "SLC",
    "predicate": "requires",
    "object": "the standard F$_1$ measure"
