  {
   "insight_id": "1910.09982::s00:i01",
   "paper_id": "1910.09982",
   "group_id": "1910.09982::s00",
   "concise_text": "Unlike earlier article-level propaganda work whose distant-supervision labels introduced noise, the shared task corpus uses professional annotators and fragment-level annotations of 18 techniques.",
   "triple": {
    "subject": "the shared task corpus",
    "predicate": "extends",
    "object": "earlier article-level propaganda work"
   },
   "relation_type": "combined_fact",
