   "unit_id": "1910.09982::u001"
  },
  {
   "insight_id": "1910.09982::s00:i02",
   "paper_id": "1910.09982",
   "group_id": "1910.09982::s00",
   "concise_text": "Because SLC labels a sentence propagandist if it contains at least one propagandist fragment, FLC span detection supplies the fragments underlying the SLC binary decision.",
   "triple": {
    "subject": "Fragment-Level Classification task (FLC)",
    "predicate": "requires",
    "object": "all spans of the text in which a propaganda technique is used"
   },
   "relation_type": "combined_fact",
